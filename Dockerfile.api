FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    TF_CPP_MIN_LOG_LEVEL=2 \
    PORT=7860 \
    MODEL_PATH=/app/model/champion.keras

WORKDIR /app
RUN useradd --create-home --uid 1000 appuser

COPY requirements-api.txt .
RUN pip install --no-compile -r requirements-api.txt

COPY --chown=appuser:appuser api.py inference.py validation.py ./
COPY --chown=appuser:appuser models/champion.keras models/champion.json model/

USER appuser
EXPOSE 7860

HEALTHCHECK --interval=30s --timeout=5s --start-period=90s --retries=3 \
  CMD python -c "import os,sys,urllib.request; sys.exit(0 if urllib.request.urlopen('http://127.0.0.1:%s/health' % os.environ['PORT'], timeout=4).status == 200 else 1)"

CMD ["sh", "-c", "exec gunicorn -b 0.0.0.0:${PORT} -w 1 --threads 4 --timeout 120 'api:create_api()'"]
